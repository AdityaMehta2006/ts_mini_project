{
  "name": "ts-mini-asml",
  "private": true,
  "version": "1.0.0",
  "description": "Time series analysis and forecast audit of ASML Holding N.V.",
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "lint": "npm run lint --prefix frontend",
    "figures": "python docs/figures/make_figures.py",
    "check-facts": "python docs/check_facts.py",
    "report": "python docs/build_report.py",
    "report:pdf": "python docs/build_report.py --pdf",
    "slides": "npx --yes @marp-team/marp-cli docs/SLIDES.md -o docs/SLIDES.pdf --allow-local-files"
  }
}
